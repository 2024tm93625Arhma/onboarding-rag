                                                                                                     "title":  "Detail"
                                                                                                 }
                                                                                  },
                                                                   "type":  "object",
                                                                   "title":  "HTTPValidationError"
                                                               },
                                       "Hit":  {
                                                   "properties":  {
                                                                      "chunk_id":  {
                                                                                       "type":  "string",
                                                                                       "title":  "Chunk Id"
                                                                                   },
                                                                      "doc_id":  {
                                                                                     "type":  "string",
                                                                                     "title":  "Doc Id"
                                                                                 },
                                                                      "title":  {
                                                                                    "type":  "string",
                                                                                    "title":  "Title"
                                                                                },
                                                                      "version":  {
                                                                                      "anyOf":  [
                                                                                                    {
                                                                                                        "type":  "string"
                                                                                                    },
                                                                                                    {
                                                                                                        "type":  "integer"
                                                                                                    },
                                                                                                    {
                                                                                                        "type":  "null"
