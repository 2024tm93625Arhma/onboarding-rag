                                                                                             "type":  "string",
                                                                                             "title":  "Department"
                                                                                         },
                                                                          "grade":  {
                                                                                        "type":  "string",
                                                                                        "title":  "Grade"
                                                                                    },
                                                                          "location":  {
                                                                                           "type":  "string",
                                                                                           "title":  "Location"
                                                                                       },
                                                                          "employment_type":  {
                                                                                                  "type":  "string",
                                                                                                  "title":  "Employment Type"
                                                                                              },
                                                                          "join_date":  {
                                                                                            "type":  "string",
                                                                                            "title":  "Join Date"
                                                                                        }
                                                                      },
                                                       "type":  "object",
                                                       "required":  [
                                                                        "user_id",
                                                                        "department",
                                                                        "grade",
                                                                        "location",
                                                                        "employment_type",
                                                                        "join_date"
                                                                    ],
                                                       "title":  "Profile"
                                                   },
                                       "ValidationError":  {
