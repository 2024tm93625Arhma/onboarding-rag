                                                                                    },
                                                                      "score":  {
                                                                                    "type":  "number",
                                                                                    "title":  "Score"
                                                                                }
                                                                  },
                                                   "type":  "object",
                                                   "required":  [
                                                                    "chunk_id",
                                                                    "doc_id",
                                                                    "title",
                                                                    "version",
                                                                    "effective_date",
                                                                    "authority",
                                                                    "score"
                                                                ],
                                                   "title":  "Hit"
                                               },
                                       "Profile":  {
                                                       "properties":  {
                                                                          "user_id":  {
