                                                                                                                      "type":  "string"
                                                                                                                  },
                                                                                                        "type":  "array",
                                                                                                        "title":  "Invalid Citations"
                                                                                                    },
                                                                              "flagged":  {
                                                                                              "type":  "boolean",
