                                                           "type":  "object",
                                                           "required":  [
                                                                            "mode",
                                                                            "answer",
                                                                            "citations",
                                                                            "invalid_citations",
                                                                            "flagged",
                                                                            "hits",
                                                                            "latency_ms"
                                                                        ],
                                                           "title":  "AskResponse"
                                                       },
                                       "HTTPValidationError":  {
